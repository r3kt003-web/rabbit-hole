# Google Gemini API Key
GOOGLE_API_KEY=your_gemini_api_key_here

# Serper API Key (https://google.serper.dev/search)
SERPER_API_KEY=your_serper_api_key_here

# Model configuration
PLANNER_MODEL=gemini-2.5-flash
RESEARCHER_MODEL=gemini-2.5-flash-lite
WRITER_MODEL=gemini-2.5-flash
EVALUATOR_MODEL=gemini-2.5-flash

# FREE-TIER MODE: Rate limits (Token bucket)
LLM_RPM=8
LLM_RPD=200

# Caching & Replay
ENABLE_CACHE=true
CACHE_DIR=.cache
# REPLAY_RUN_ID=

# Execution limits & thresholds
MAX_REVISIONS=2
MAX_RUN_COST_USD=2.0
CONCURRENCY_LIMIT=3
WORKER_TIMEOUT_SECONDS=30.0
WORKER_MAX_RETRIES=2
CITATION_FUZZY_THRESHOLD=0.7
PASS_THRESHOLD=3.5
SERPER_PRICE_PER_CALL=0.001

# Optional API Auth
API_KEY=

# Optional LangSmith Tracing
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
